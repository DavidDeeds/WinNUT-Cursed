<Project>
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">3.0.0</Version>
    <Company>NUTDotNet</Company>
    <Product>WinNUT-Cursed</Product>
    <Copyright>Gawindx (Decaux Nicolas) © 2019-2021; NUT Dot Net project © 2022+</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>
  <!-- PreRelease matches former VB solution configuration (installer / CI). -->
  <PropertyGroup Condition="'$(Configuration)' == 'PreRelease'">
    <Optimize>true</Optimize>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
  </PropertyGroup>
</Project>
